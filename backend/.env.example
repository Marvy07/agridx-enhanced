# AgriDX Enhanced — Backend Environment Variables
# Copy this to .env and fill in values as needed.
# All values are optional for local development — the backend starts without any of them.

# ----- LOCAL DEV -----
# Set DEV_MODE=true to bypass Firebase auth and use a mock user (dev@agridx.app)
DEV_MODE=true
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# ----- FIREBASE (optional for local dev) -----
# Leave blank to run in dev mock mode (no Firebase connection required)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ----- GCP / VERTEX AI (not needed until Phase 1 ML) -----
# GOOGLE_CLOUD_PROJECT=
# VERTEX_AI_LOCATION=us-central1
# PLANT_MODEL_ENDPOINT=
# ANIMAL_MODEL_ENDPOINT=

# ----- AI APIS (optional) -----
GEMINI_API_KEY=
GROQ_API_KEY=

# ----- PAYMENTS (not wired yet — Phase 1) -----
# PAYSTACK_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# REVENUECAT_API_KEY=

# ----- MONITORING (optional) -----
# SENTRY_DSN=
