# AgriDX Enhanced — Flutter App Environment Variables
# Copy this to .env and fill in values as needed.
# GEMINI_API_KEY and OPENWEATHER_API_KEY are needed for AI chat and weather features.
# Leave blank to run with limited functionality.

# Backend API (local dev default)
API_BASE_URL=http://localhost:8000

# AI
GEMINI_API_KEY=
GROQ_API_KEY=

# Weather
OPENWEATHER_API_KEY=

# News
NEWS_API_KEY=
